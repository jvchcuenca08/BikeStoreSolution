@model BikeStore.Models.Venta

@{
    ViewData["Title"] = "Detalle de Venta";
}

<div class="container mt-4">

    <div class="mb-4">
        <h1 class="fw-bold">
            🧾 Detalle de Venta
        </h1>

        <p class="text-muted">
            Información completa de la venta registrada.
        </p>
    </div>

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <div class="row">

                <div class="col-md-3 mb-3">
                    <strong>ID Venta:</strong>
                    <p>@Model.IdVenta</p>
                </div>

                <div class="col-md-3 mb-3">
                    <strong>Fecha:</strong>
                    <p>@Model.Fecha.ToString("dd/MM/yyyy HH:mm")</p>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Cliente:</strong>
                    <p>@Model.Cliente</p>
                </div>

            </div>

        </div>

    </div>

    <h4 class="mb-3">
        Productos vendidos
    </h4>

    <table class="table table-striped table-bordered">

        <thead>
            <tr>
                <th>Bicicleta</th>
                <th>Cantidad</th>
                <th>Precio Unitario</th>
                <th>Subtotal</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var detalle in Model.Detalles)
            {
                <tr>
                    <td>
                        @detalle.Bicicleta
                    </td>

                    <td>
                        @detalle.Cantidad
                    </td>

                    <td>
                        $@detalle.Precio.ToString("N2")
                    </td>

                    <td>
                        $@detalle.Subtotal.ToString("N2")
                    </td>
                </tr>
            }

        </tbody>

    </table>

    <div class="row justify-content-end">

        <div class="col-md-4">

            <div class="card shadow-sm">

                <div class="card-body">

                    <div class="d-flex justify-content-between">
                        <strong>Subtotal:</strong>
                        <span>
                            $@Model.Subtotal.ToString("N2")
                        </span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <strong>IVA (15%):</strong>
                        <span>
                            $@Model.Iva.ToString("N2")
                        </span>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between fs-5">
                        <strong>Total:</strong>
                        <strong>
                            $@Model.Total.ToString("N2")
                        </strong>
                    </div>

                </div>

            </div>

        </div>

    </div>

    <div class="mt-4">

        <a asp-action="Index"
           class="btn btn-secondary">
            ← Volver al Historial
        </a>

    </div>

</div>