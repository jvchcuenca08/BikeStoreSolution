@model List<BikeStore.Models.Venta>

@{
    ViewData["Title"] = "Historial de Ventas";
}

<h1>Historial de Ventas</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Nueva Venta
    </a>
</p>

<!-- ============================================= -->
<!-- BUSCAR VENTAS POR CLIENTE -->
<!-- ============================================= -->

<form asp-action="PorCliente"
      method="get"
      class="row g-3 mb-4">

    <div class="col-md-5">

        <label class="form-label">
            Consultar ventas por cliente
        </label>

        <input type="number"
               name="idCliente"
               class="form-control"
               min="1"
               placeholder="Ingrese el ID del cliente"
               required />

    </div>

    <div class="col-md-4 d-flex align-items-end">

        <button type="submit"
                class="btn btn-primary me-2">
            Buscar
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Ver todas
        </a>

    </div>

</form>

<!-- ============================================= -->
<!-- MENSAJE DE ERROR -->
<!-- ============================================= -->
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}

<!-- ============================================= -->
<!-- HISTORIAL DE VENTAS -->
<!-- ============================================= -->

<table class="table table-striped table-bordered">

    <thead>
        <tr>
            <th>ID</th>
            <th>Fecha</th>
            <th>Cliente</th>
            <th>Subtotal</th>
            <th>IVA</th>
            <th>Total</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var venta in Model)
        {
            <tr>

                <td>
                    @venta.IdVenta
                </td>

                <td>
                    @venta.Fecha.ToString("dd/MM/yyyy HH:mm")
                </td>

                <td>
                    @venta.Cliente
                </td>

                <td>
                    $@venta.Subtotal.ToString("N2")
                </td>

                <td>
                    $@venta.Iva.ToString("N2")
                </td>

                <td>
                    <strong>
                        $@venta.Total.ToString("N2")
                    </strong>
                </td>

                <td>

                    <a asp-action="Details"
                       asp-route-id="@venta.IdVenta"
                       class="btn btn-info btn-sm">
                        Ver detalle
                    </a>

                </td>

            </tr>
        }

    </tbody>

</table>