@model List<BikeStore.Models.Venta>

@{
    ViewData["Title"] = "Historial de Ventas";
}

<h1>Historial de Ventas</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Nueva Venta
    </a>
</p>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Fecha</th>
            <th>Cliente</th>
            <th>Subtotal</th>
            <th>IVA</th>
            <th>Total</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var venta in Model)
        {
            <tr>
                <td>@venta.IdVenta</td>

                <td>
                    @venta.Fecha.ToString("dd/MM/yyyy HH:mm")
                </td>

                <td>@venta.Cliente</td>

                <td>
                    $@venta.Subtotal.ToString("N2")
                </td>

                <td>
                    $@venta.Iva.ToString("N2")
                </td>

                <td>
                    <strong>
                        $@venta.Total.ToString("N2")
                    </strong>
                </td>

                <td>
                    <a asp-action="Details"
                       asp-route-id="@venta.IdVenta"
                       class="btn btn-info btn-sm">
                        Ver detalle
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>