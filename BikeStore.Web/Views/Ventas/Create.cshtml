@using BikeStore.Models

@{
    ViewData["Title"] = "Nueva Venta";

    var clientes = ViewBag.Clientes as List<Cliente> ?? new List<Cliente>();
    var bicicletas = ViewBag.Bicicletas as List<Bicicleta> ?? new List<Bicicleta>();
}

<h1>Nueva Venta</h1>

<hr />

<div class="row">
    <div class="col-md-8">

        <div class="mb-3">
            <label class="form-label">
                Cliente
            </label>

            <select id="cliente"
                    class="form-select">

                <option value="">
                    -- Seleccione un cliente --
                </option>

                @foreach (var cliente in clientes)
                {
                    <option value="@cliente.IdCliente">
                        @cliente.Cedula - @cliente.Nombres @cliente.Apellidos
                    </option>
                }

            </select>
        </div>

        <hr />

        <h4>Agregar bicicleta</h4>

        <div class="row">

            <div class="col-md-5">
                <label class="form-label">
                    Bicicleta
                </label>

                <select id="bicicleta"
                        class="form-select">

                    <option value="">
                        -- Seleccione una bicicleta --
                    </option>

                    @foreach (var bicicleta in bicicletas)
                    {
                        <option value="@bicicleta.IdBicicleta"
                                data-precio="@bicicleta.Precio">
                            @bicicleta.Marca @bicicleta.Modelo
                            - $@bicicleta.Precio.ToString("N2")
                            - Stock: @bicicleta.Stock
                        </option>
                    }

                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label">
                    Cantidad
                </label>

                <input id="cantidad"
                       type="number"
                       min="1"
                       value="1"
                       class="form-control" />
            </div>

            <div class="col-md-4 d-flex align-items-end">
                <button type="button"
                        id="btnAgregar"
                        class="btn btn-success">
                    Agregar
                </button>
            </div>

        </div>

        <hr />

        <h4>Detalle de la venta</h4>

        <table class="table table-bordered"
               id="tablaDetalle">

            <thead>
                <tr>
                    <th>Bicicleta</th>
                    <th>Cantidad</th>
                    <th>Precio</th>
                    <th>Subtotal</th>
                </tr>
            </thead>

            <tbody>
            </tbody>

        </table>

        <div class="text-end">

            <p>
                <strong>Subtotal:</strong>
                $<span id="subtotalGeneral">0.00</span>
            </p>

            <p>
                <strong>IVA (15%):</strong>
                $<span id="iva">0.00</span>
            </p>

            <h4>
                Total:
                $<span id="total">0.00</span>
            </h4>

        </div>

        <button type="button"
                id="btnRegistrarVenta"
                class="btn btn-primary">
            Registrar Venta
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Cancelar
        </a>

    </div>
</div>
@section Scripts {
    <script>
        let subtotalGeneral = 0;
        let detallesVenta = [];

        document.getElementById("btnAgregar").addEventListener("click", function() {

            const selectBicicleta = document.getElementById("bicicleta");
            const cantidadInput = document.getElementById("cantidad");

            const opcionSeleccionada =
                selectBicicleta.options[selectBicicleta.selectedIndex];

            const idBicicleta = parseInt(selectBicicleta.value);

            if (!idBicicleta) {
                alert("Seleccione una bicicleta.");
                return;
            }

            const cantidad = parseInt(cantidadInput.value);

            if (isNaN(cantidad) || cantidad <= 0) {
                alert("Ingrese una cantidad válida.");
                return;
            }

            const precio = parseFloat(
                opcionSeleccionada.getAttribute("data-precio")
            );

            const nombreBicicleta = opcionSeleccionada.text;

            const subtotal = precio * cantidad;

            // Guardamos el detalle que posteriormente enviaremos al API
            detallesVenta.push({
                idBicicleta: idBicicleta,
                cantidad: cantidad,
                precio: precio,
                subtotal: subtotal
            });

            const fila = document.createElement("tr");

            fila.innerHTML = `
                        <td>${nombreBicicleta}</td>
                        <td>${cantidad}</td>
                        <td>$${precio.toFixed(2)}</td>
                        <td>$${subtotal.toFixed(2)}</td>
                    `;

            document
                .querySelector("#tablaDetalle tbody")
                .appendChild(fila);

            subtotalGeneral += subtotal;

            actualizarTotales();

            cantidadInput.value = 1;
        });


        function actualizarTotales() {

            const iva = subtotalGeneral * 0.15;
            const total = subtotalGeneral + iva;

            document.getElementById("subtotalGeneral").textContent =
                subtotalGeneral.toFixed(2);

            document.getElementById("iva").textContent =
                iva.toFixed(2);

            document.getElementById("total").textContent =
                total.toFixed(2);
        }


        // =====================================================
        // REGISTRAR VENTA REAL
        // =====================================================

        document.getElementById("btnRegistrarVenta")
            .addEventListener("click", async function() {

                const idCliente =
                    parseInt(document.getElementById("cliente").value);

                if (!idCliente) {
                    alert("Seleccione un cliente.");
                    return;
                }

                if (detallesVenta.length === 0) {
                    alert("Debe agregar al menos una bicicleta.");
                    return;
                }

                const venta = {
                    idCliente: idCliente,

                    detalles: detallesVenta.map(detalle => ({
                        idBicicleta: detalle.idBicicleta,
                        cantidad: detalle.cantidad
                    }))
                };

                try {

                    const respuesta = await fetch(
                        "/Ventas/Create",
                        {
                            method: "POST",

                            headers: {
                                "Content-Type": "application/json"
                            },

                            body: JSON.stringify(venta)
                        }
                    );

                    const resultado = await respuesta.json();

                    if (respuesta.ok) {

                        alert("Venta registrada correctamente.");

                        window.location.href = "/Ventas";
                    }
                    else {

                        alert(
                            resultado.mensaje ||
                            "No se pudo registrar la venta."
                        );
                    }

                }
                catch (error) {

                    alert(
                        "Ocurrió un error al registrar la venta."
                    );
                }
            });

    </script>
}