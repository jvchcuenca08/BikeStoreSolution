@model BikeStore.Models.Categoria

@{
    ViewData["Title"] = "Eliminar Categoría";
}

<h1>Eliminar Categoría</h1>

<div class="alert alert-warning">
    ¿Está seguro de que desea eliminar esta categoría?
</div>

<dl class="row">
    <dt class="col-sm-2">
        ID
    </dt>
    <dd class="col-sm-10">
        @Model.IdCategoria
    </dd>

    <dt class="col-sm-2">
        Nombre
    </dt>
    <dd class="col-sm-10">
        @Model.Nombre
    </dd>

    <dt class="col-sm-2">
        Descripción
    </dt>
    <dd class="col-sm-10">
        @Model.Descripcion
    </dd>

    <dt class="col-sm-2">
        Activo
    </dt>
    <dd class="col-sm-10">
        @(Model.Activo ? "Sí" : "No")
    </dd>
</dl>

<form asp-action="DeleteConfirmed" method="post">

    <input type="hidden"
           name="id"
           value="@Model.IdCategoria" />

    <button type="submit"
            class="btn btn-danger">
        Eliminar
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancelar
    </a>

</form>