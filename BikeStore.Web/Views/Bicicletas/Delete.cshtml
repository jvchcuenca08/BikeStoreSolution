@model BikeStore.Models.Bicicleta

@{
    ViewData["Title"] = "Eliminar Bicicleta";
}

<div class="container mt-4">

    <div class="mb-4">

        <h1 class="fw-bold text-danger">
            🗑️ Eliminar bicicleta
        </h1>

        <p class="text-muted">
            Confirma si deseas eliminar esta bicicleta.
        </p>

    </div>

    <div class="card shadow-sm border-danger">

        <div class="card-body">

            <div class="alert alert-warning">
                <strong>⚠️ Atención:</strong>
                Esta acción eliminará la bicicleta del inventario.
            </div>

            <h4 class="mb-4">
                ¿Está seguro de que desea eliminar esta bicicleta?
            </h4>

            <div class="row">

                <div class="col-md-6 mb-3">

                    <strong>ID:</strong>

                    <p>
                        @Model.IdBicicleta
                    </p>

                </div>

                <div class="col-md-6 mb-3">

                    <strong>Marca:</strong>

                    <p>
                        @Model.Marca
                    </p>

                </div>

                <div class="col-md-6 mb-3">

                    <strong>Modelo:</strong>

                    <p>
                        @Model.Modelo
                    </p>

                </div>

                <div class="col-md-6 mb-3">

                    <strong>Precio:</strong>

                    <p>
                        $@Model.Precio.ToString("N2")
                    </p>

                </div>

                <div class="col-md-6 mb-3">

                    <strong>Stock:</strong>

                    <p>
                        @Model.Stock
                    </p>

                </div>

                <div class="col-md-6 mb-3">

                    <strong>Estado:</strong>

                    <p>
                        @Model.Estado
                    </p>

                </div>

            </div>

            <hr />

            <form asp-action="DeleteConfirmed" method="post">

                <input type="hidden"
                       asp-for="IdBicicleta" />

                <a asp-controller="Bicicletas"
                   asp-action="Index"
                   class="btn btn-secondary">
                    ← Cancelar
                </a>

                <button type="submit"
                        class="btn btn-danger">
                    🗑️ Sí, eliminar
                </button>

            </form>

        </div>

    </div>

</div>