@model BikeStore.Models.Bicicleta

@{
    ViewData["Title"] = "Nueva Bicicleta";
}

<div class="container mt-4">

    <div class="mb-4">
        <h1 class="fw-bold">🚲 Nueva bicicleta</h1>
        <p class="text-muted">
            Registra una nueva bicicleta en el inventario.
        </p>
    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <form asp-action="Create" method="post">

                <div class="row">

                    <!-- Marca -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="Marca" class="form-label">
                            Marca
                        </label>

                        <input asp-for="Marca"
                               class="form-control"
                               placeholder="Ej. Trek" />

                        <span asp-validation-for="Marca"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Modelo -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="Modelo" class="form-label">
                            Modelo
                        </label>

                        <input asp-for="Modelo"
                               class="form-control"
                               placeholder="Ej. Marlin 5" />

                        <span asp-validation-for="Modelo"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Categoría -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="IdCategoria"
                               class="form-label">
                            Categoría
                        </label>

                        <select asp-for="IdCategoria"
                                class="form-select">
                            <span asp-validation-for="IdCategoria"
                                  class="text-danger">
                            </span>

                            <option value="0">
                                -- Seleccione una categoría --
                            </option>

                            <option value="1">
                                Montaña
                            </option>

                            <option value="2">
                                Ruta
                            </option>

                            <option value="3">
                                BMX
                            </option>

                            <option value="4">
                                Eléctricas
                            </option>

                            <option value="5">
                                Infantiles
                            </option>

                        </select>

                        <span asp-validation-for="IdCategoria"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Precio -->
                    <div class="col-md-3 mb-3">

                        <label asp-for="Precio"
                               class="form-label">
                            Precio
                        </label>

                        <input asp-for="Precio"
                               type="number"
                               step="0.01"
                               min="0"
                               class="form-control"
                               placeholder="0.00" />

                        <span asp-validation-for="Precio"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Stock -->
                    <div class="col-md-3 mb-3">

                        <label asp-for="Stock"
                               class="form-label">
                            Stock
                        </label>

                        <input asp-for="Stock"
                               type="number"
                               min="0"
                               class="form-control"
                               placeholder="0" />

                        <span asp-validation-for="Stock"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Estado -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="Estado"
                               class="form-label">
                            Estado
                        </label>

                        <select asp-for="Estado"
                                class="form-select">

                            <option value="DISPONIBLE">
                                Disponible
                            </option>

                            <option value="AGOTADO">
                                Agotado
                            </option>

                            <option value="INACTIVO">
                                Inactivo
                            </option>

                        </select>

                    </div>

                </div>


                <!-- Botones -->

                <div class="mt-4">

                    <a asp-controller="Bicicletas"
                       asp-action="Index"
                       class="btn btn-secondary">
                        ← Cancelar
                    </a>

                    <button type="submit"
                            class="btn btn-primary">
                        💾 Guardar bicicleta
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}