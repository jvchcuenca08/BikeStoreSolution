@model IEnumerable<BikeStore.Models.Bicicleta>

@{
    ViewData["Title"] = "Bicicletas";
}

<div class="container mt-4">

    <!-- ENCABEZADO -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold">🚲 Bicicletas</h1>

            <p class="text-muted mb-0">
                Administración del inventario de bicicletas
            </p>
        </div>

        <a asp-controller="Bicicletas"
           asp-action="Create"
           class="btn btn-primary">
            + Nueva bicicleta
        </a>

    </div>


    <!-- FILTROS -->
    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <form asp-controller="Bicicletas"
                  asp-action="Index"
                  method="get">

                <div class="row g-3">

                    <!-- BUSCAR -->
                    <div class="col-md-4">

                        <label class="form-label">
                            Buscar
                        </label>

                        <input type="text"
                               name="busqueda"
                               value="@ViewBag.Busqueda"
                               class="form-control"
                               placeholder="Marca o modelo..." />

                    </div>


                    <!-- CATEGORÍA -->
                    <div class="col-md-3">

                        <label class="form-label">
                            Categoría
                        </label>

                        <select name="categoria"
                                class="form-select">

                            <option value="">
                                Todas las categorías
                            </option>

                            <option value="1"
                                    selected="@(ViewBag.Categoria == 1)">
                                Montaña
                            </option>

                            <option value="2"
                                    selected="@(ViewBag.Categoria == 2)">
                                Ruta
                            </option>

                            <option value="3"
                                    selected="@(ViewBag.Categoria == 3)">
                                BMX
                            </option>

                            <option value="4"
                                    selected="@(ViewBag.Categoria == 4)">
                                Eléctricas
                            </option>

                            <option value="5"
                                    selected="@(ViewBag.Categoria == 5)">
                                Infantiles
                            </option>

                        </select>

                    </div>


                    <!-- STOCK -->
                    <div class="col-md-3">

                        <label class="form-label">
                            Inventario
                        </label>

                        <select name="stockFiltro"
                                class="form-select">

                            <option value="">
                                Todo el inventario
                            </option>

                            <option value="bajo"
                                    selected="@(ViewBag.StockFiltro == "bajo")">
                                ⚠️ Stock bajo
                            </option>

                            <option value="agotado"
                                    selected="@(ViewBag.StockFiltro == "agotado")">
                                ❌ Agotados
                            </option>

                        </select>

                    </div>


                    <!-- BOTÓN -->
                    <div class="col-md-2 d-flex align-items-end">

                        <button type="submit"
                                class="btn btn-dark w-100">
                            🔍 Buscar
                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- INFORMACIÓN -->
    <div class="d-flex justify-content-between align-items-center mb-3">

        <div>

            <span class="text-muted">
                Bicicletas encontradas:
            </span>

            <strong>
                @Model.Count()
            </strong>

        </div>

        <a asp-controller="Bicicletas"
           asp-action="Index"
           class="btn btn-outline-secondary btn-sm">
            ↻ Limpiar filtros
        </a>

    </div>


    <!-- TABLA -->
    <div class="card shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-dark">

                        <tr>

                            <th>ID</th>
                            <th>Marca</th>
                            <th>Modelo</th>
                            <th>Categoría</th>
                            <th>Precio</th>
                            <th>Stock</th>
                            <th>Estado</th>
                            <th>Acciones</th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (!Model.Any())
                        {
                            <tr>

                                <td colspan="8"
                                    class="text-center py-4">

                                    <div class="text-muted">

                                        <h5>
                                            🔍 No se encontraron bicicletas
                                        </h5>

                                        <p class="mb-0">
                                            Intenta cambiar los filtros de búsqueda.
                                        </p>

                                    </div>

                                </td>

                            </tr>
                        }
                        else
                        {
                            @foreach (var bicicleta in Model)
                            {
                                <tr>

                                    <!-- ID -->
                                    <td>
                                        @bicicleta.IdBicicleta
                                    </td>


                                    <!-- MARCA -->
                                    <td>
                                        <strong>
                                            @bicicleta.Marca
                                        </strong>
                                    </td>


                                    <!-- MODELO -->
                                    <td>
                                        @bicicleta.Modelo
                                    </td>


                                    <!-- CATEGORÍA -->
                                    <td>

                                        @switch (bicicleta.IdCategoria)
                                        {
                                            case 1:
                                                <span>Montaña</span>
                                                break;

                                            case 2:
                                                <span>Ruta</span>
                                                break;

                                            case 3:
                                                <span>BMX</span>
                                                break;

                                            case 4:
                                                <span>Eléctricas</span>
                                                break;

                                            case 5:
                                                <span>Infantiles</span>
                                                break;

                                            default:
                                                <span>Sin categoría</span>
                                                break;
                                        }

                                    </td>


                                    <!-- PRECIO -->
                                    <td>
                                        $@bicicleta.Precio.ToString("N2")
                                    </td>


                                    <!-- STOCK -->
                                    <td>
                                        @bicicleta.Stock
                                    </td>


                                    <!-- ESTADO -->
                                    <td>

                                        @if (bicicleta.Stock == 0)
                                        {
                                            <span class="badge bg-danger">
                                                AGOTADO
                                            </span>
                                        }
                                        else if (bicicleta.Stock <= 3)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                STOCK BAJO
                                            </span>
                                        }
                                        else if (bicicleta.Estado == "INACTIVO")
                                        {
                                            <span class="badge bg-secondary">
                                                INACTIVO
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">
                                                DISPONIBLE
                                            </span>
                                        }

                                    </td>


                                    <!-- ACCIONES -->
                                    <td>

                                        <div class="d-flex gap-1">

                                            <a asp-controller="Bicicletas"
                                               asp-action="Edit"
                                               asp-route-id="@bicicleta.IdBicicleta"
                                               class="btn btn-warning btn-sm">
                                                ✏️ Editar
                                            </a>

                                            <a asp-controller="Bicicletas"
                                               asp-action="Delete"
                                               asp-route-id="@bicicleta.IdBicicleta"
                                               class="btn btn-danger btn-sm">
                                                🗑️ Eliminar
                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>
