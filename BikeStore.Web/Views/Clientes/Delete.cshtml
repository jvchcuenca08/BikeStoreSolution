@model BikeStore.Models.Cliente

@{
    ViewData["Title"] = "Eliminar Cliente";
}

<h1>Eliminar Cliente</h1>

<div class="alert alert-warning">
    ¿Está seguro de que desea eliminar este cliente?
</div>

<dl class="row">
    <dt class="col-sm-2">ID</dt>
    <dd class="col-sm-10">@Model.IdCliente</dd>

    <dt class="col-sm-2">Cédula</dt>
    <dd class="col-sm-10">@Model.Cedula</dd>

    <dt class="col-sm-2">Nombres</dt>
    <dd class="col-sm-10">@Model.Nombres</dd>

    <dt class="col-sm-2">Apellidos</dt>
    <dd class="col-sm-10">@Model.Apellidos</dd>

    <dt class="col-sm-2">Teléfono</dt>
    <dd class="col-sm-10">@Model.Telefono</dd>

    <dt class="col-sm-2">Correo</dt>
    <dd class="col-sm-10">@Model.Correo</dd>
</dl>

<form asp-action="DeleteConfirmed" method="post">

    <input type="hidden"
           name="id"
           value="@Model.IdCliente" />

    <button type="submit"
            class="btn btn-danger">
        Eliminar
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancelar
    </a>

</form>